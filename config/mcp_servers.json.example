{
  "mem0": {
    "command": "uvx",
    "args": ["mem0-mcp-server"],
    "env": {
      "MEM0_API_KEY": "YOUR_API_KEY_HERE",
      "MEM0_TELEMETRY": "false",
      "ANONYMOUS_TELEMETRY": "false"
    },
    "enabled": false
  },
  "filesystem": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-filesystem", "./data"],
    "enabled": false
  }
}
