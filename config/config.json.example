{
  "_comment": "此文件仅作为示例展示字段，请勿直接修改此文件。程序运行时会自动生成并使用 config/config.json",
  "blacklistedQQs": [],
  "enabledGroups": [],
  "linkCacheTimeout": 600,
  "subscriptionCheckInterval": 60,
  "nightMode": {
    "mode": "off",
    "startTime": "21:00",
    "endTime": "06:00"
  },
  "labelConfig": {
    "video": true,
    "bangumi": true,
    "article": true,
    "live": true,
    "dynamic": true,
    "user": true,
    "interactive_video": true,
    "favorite_list": true,
    "audio": true,
    "audio_list": true,
    "topic": true,
    "channel_series": true,
    "article_list": true,
    "note": true,
    "cheese_video": true
  },
  "showId": true,
  "agent": {
    "enabled": false,
    "observeOnly": true,
    "logTrajectory": true,
    "defaultGroupEnabled": false,
    "decisionMode": "rule_only",
    "sendEnabled": false,
    "aliases": [],
    "shortTerm": {
      "maxRecentMessagesPerGroup": 100,
      "topicIdleMs": 1800000,
      "crowdedMessagesPerMinute": 8
    },
    "replyPolicy": {
      "minReplyScore": 0.72,
      "cooldownMs": 30000
    },
    "llm": {
      "enabled": false,
      "apiKeyEnv": "AGENT_API_KEY",
      "timeoutMs": 12000,
      "temperature": 0.2,
      "maxTokens": 500
    },
    "groups": {}
  },
  "groupConfigs": {
    "_example_group_id": {
      "_comment": "群级配置示例，每个群可以有独立配置",
      "subscriptionAtAll": false,
      "subscriptionAtAllRules": {
        "sources": {
          "manual": true,
          "cookieSync": true
        },
        "categories": {
          "video": true,
          "dynamic": true,
          "live": true,
          "article": true,
          "bangumi": true,
          "movie": true,
          "tv": true,
          "guocha": true,
          "doc": true,
          "variety": true
        },
        "manualDisabledIds": [],
        "cookieSyncDisabledIds": []
      },
      "admins": [
        "123456789"
      ]
    }
  }
