# ==================== NapCat 连接配置 ====================
# NapCat WebSocket 地址 (通常是 NapCat 开启的正向 WS 端口)
WS_URL=ws://napcat:3001

# WebSocket Token (可选，留空则不启用身份验证)
# 需要与 NapCat 配置文件中的 token 保持一致
WS_TOKEN=

# ==================== 管理员配置 ====================
# 管理员 QQ 号 (用于执行敏感指令，如订阅管理)
ADMIN_QQ=123456789

# ==================== 图片发送配置 ====================
# 是否直接通过 Base64 发送图片 (true/false)
# - true: 直接发送Base64编码的图片，无需配置目录映射，但会增加网络传输负担
# - false (推荐): 通过文件路径发送，需要正确配置 Docker 目录映射
USE_BASE64_SEND=false

# NapCat 临时文件路径配置 (仅在 USE_BASE64_SEND=false 时需要配置)
# 说明：需要确保 BiliBot 和 NapCat 两个容器可以访问同一物理目录
#
# NAPCAT_TEMP_PATH: BiliBot 写入图片的路径 (BiliBot 容器内的路径)
# 默认: /app/.config/QQ/tmp/
NAPCAT_TEMP_PATH=/app/.config/QQ/tmp/

# NAPCAT_READ_PATH: NapCat 读取图片的路径 (NapCat 容器内的路径)
# 默认: /app/.config/QQ/tmp/
# 注意：这两个路径必须指向同一物理目录（通过 docker-compose volumes 映射）
NAPCAT_READ_PATH=/app/.config/QQ/tmp/

# ==================== 缓存配置 ====================
# 数据持久化缓存过期时间 (秒)
# 默认 3600 秒 (1小时)。过期后会重新请求 Bilibili API 获取最新数据
DATA_CACHE_TTL=3600

# ==================== AI 对话配置 ====================
# AI API 地址 (OpenAI 兼容接口)
# 示例:
# - OpenAI: https://api.openai.com/v1/chat/completions
# - DeepSeek: https://api.deepseek.com/v1/chat/completions
# - 其他兼容服务: 根据服务商文档配置
AI_API_URL=https://api.openai.com/v1/chat/completions

# AI API Key (必填，如需使用 AI 对话功能)
AI_API_KEY=

# AI 模型名称
# 示例: gpt-3.5-turbo, gpt-4, deepseek-chat 等
AI_MODEL=gpt-3.5-turbo

# AI 随机回复概率 (0.0 到 1.0)
# 0.0 = 不主动回复, 0.1 = 10% 概率回复, 1.0 = 总是回复
# 注意：@机器人时总是会回复，此概率仅影响未@时的主动回复
AI_PROBABILITY=0.1

# AI 系统提示词 (角色设定)
# 定义机器人的性格、说话方式、行为规范等
# 使用 \n 表示换行
AI_SYSTEM_PROMPT=你是一名可爱的猫娘机器人，说话自然、亲切，句尾会带上“喵”。


# ==================== AI Embedding 配置（向量记忆功能）====================
# 用于实现长期记忆和语义检索功能
# 如不需要此功能，可以留空

# Embedding API 地址
# 示例:
# - OpenAI: https://api.openai.com/v1/embeddings
# - 阿里云通义: https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
AI_EMBEDDING_API_URL=https://api.openai.com/v1/embeddings

# Embedding API Key (留空则使用 AI_API_KEY)
AI_EMBEDDING_API_KEY=

# Embedding 模型名称
# 示例: text-embedding-3-small, text-embedding-v4 等
AI_EMBEDDING_MODEL=text-embedding-3-small

# ==================== 代理配置 ====================
# HTTP 代理配置 (可选)
# 格式: http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
# 留空则直连

# AI 对话代理 (用于 AI_API_URL)
AI_CHAT_PROXY=

# Embedding 代理 (用于 AI_EMBEDDING_API_URL)
AI_EMBEDDING_PROXY=

# ==================== Python 配置 ====================
# Python 解释器路径 (可选)
# Docker 环境下默认使用系统的 python3
# 本地开发环境建议指向虚拟环境
# 示例: PYTHON_PATH=venv/bin/python
# PYTHON_PATH=

# ===================== WEBUI 配置 ====================
DASHBOARD_PASSWORD=admin