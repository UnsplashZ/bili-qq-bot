# ==================== NapCat 连接配置 ====================
# NapCat WebSocket 地址，通常是 NapCat 正向 WS 端口。
WS_URL=ws://napcat:3001

# WebSocket Token，可选；需要与 NapCat 配置保持一致。
WS_TOKEN=

# ==================== QQ 连接 Provider ====================
# 连接模式：napcat 表示 OneBot/NapCat；official 表示 QQ 官方机器人 OpenAPI + WSS。
QQ_PROVIDER=napcat

# QQ 官方机器人 AppID / Secret；示例文件留空，本地 config/.env 填写。
QQ_OFFICIAL_APP_ID=
QQ_OFFICIAL_CLIENT_SECRET=

# QQ 官方 OpenAPI / Token / Gateway 配置。
QQ_OFFICIAL_API_BASE=https://api.sgroup.qq.com
QQ_OFFICIAL_TOKEN_URL=https://bots.qq.com/app/getAppAccessToken
QQ_OFFICIAL_USE_SHARDED_GATEWAY=true
QQ_OFFICIAL_INTENTS=33554432
QQ_OFFICIAL_GATEWAY_ACK_TIMEOUT_MS=90000

# QQ 官方富媒体发送策略：hybrid / url_only / file_data。
QQ_OFFICIAL_MEDIA_UPLOAD_MODE=hybrid

# 发送本地文件或视频时使用的临时公网 Base URL；必须是公网 http/https。
# 如果使用内置临时静态服务，建议指向 Dashboard 公网地址下的 /qq-official-temp/。
# 示例：https://bot.example.com/qq-official-temp/
QQ_OFFICIAL_TEMP_PUBLIC_BASE_URL=

# QQ 官方模式 Root 管理员 openid，多个用逗号分隔；不要填写数字 QQ 号。
QQ_OFFICIAL_ROOT_OPENIDS=

# QQ 官方主动消息限流队列。
QQ_OFFICIAL_ACCOUNT_QPM=30
QQ_OFFICIAL_GROUP_QPM=20
QQ_OFFICIAL_QUEUE_MAX_SIZE=300

# ==================== 管理员配置 ====================
# Root 管理员 QQ 号，用于敏感指令和全局管理。
ADMIN_QQ=123456789

# ==================== 图片发送配置 ====================
# 是否直接通过 Base64 发送图片；Docker 推荐 false。
USE_BASE64_SEND=false

# Bot 写入图片时使用的真实物理路径。
NAPCAT_TEMP_PATH=/app/.config/QQ/tmp/

# NapCat 读取图片时使用的容器内路径。
NAPCAT_READ_PATH=/app/.config/QQ/tmp/

# ==================== 浏览器配置 ====================
# 预览图渲染使用的 Chromium/Chrome 可执行文件路径；Docker 默认无需修改。
PUPPETEER_EXECUTABLE_PATH=

# Agent 网页读取/截图使用的 Chromium/Chrome 可执行文件路径；留空则优先复用 PUPPETEER_EXECUTABLE_PATH 或自动检测。
CHROMIUM_PATH=

# ==================== 缓存配置 ====================
# 数据持久化缓存过期时间，单位秒。
DATA_CACHE_TTL=3600

# ==================== Agent LLM 配置 ====================
# 是否启用 Agent LLM 决策调用。
AGENT_LLM_ENABLED=false

# LLM Provider；当前支持 openai-compatible。
AGENT_LLM_PROVIDER=openai-compatible

# OpenAI-compatible Base URL，例如 https://api.deepseek.com。
AGENT_LLM_BASE_URL=

# Agent 决策模型名。
AGENT_LLM_MODEL=

# 保存 API Key 的环境变量名。
AGENT_LLM_API_KEY_ENV=AGENT_API_KEY

# Agent LLM API Key；本地 .env 填写，示例文件留空。
AGENT_API_KEY=

# LLM 请求超时时间，单位毫秒。
AGENT_LLM_TIMEOUT_MS=12000

# LLM 决策温度。
AGENT_LLM_TEMPERATURE=0.2

# LLM 决策最大输出 token；不是上下文窗口大小。
AGENT_LLM_MAX_TOKENS=500

# ==================== Agent 调用预算 ====================
# 是否启用 Agent LLM 调用预算。
AGENT_BUDGET_ENABLED=true

# 预算统计窗口，单位毫秒。
AGENT_BUDGET_WINDOW_MS=60000

# 每群每分钟最大 LLM 调用数。
AGENT_BUDGET_MAX_LLM_CALLS_PER_GROUP_PER_MINUTE=60

# 每用户每分钟最大 LLM 调用数。
AGENT_BUDGET_MAX_LLM_CALLS_PER_USER_PER_MINUTE=20

# ==================== Python 配置 ====================
# Python 解释器路径；本地开发可填 venv/bin/python。
PYTHON_PATH=

# ==================== WebUI 配置 ====================
# Dashboard 登录密码。
DASHBOARD_PASSWORD=admin

# 公网部署时配置允许来源，多个来源用逗号分隔。
DASHBOARD_ALLOWED_ORIGINS=

# ==================== 日志显示配置 ====================
# 终端最低显示等级：trace/debug/info/warn/error/fatal。
LOG_LEVEL=info

# 仅显示指定日志 Channel，多个值用逗号分隔。
LOG_CHANNELS=

# 排除指定日志 Channel，多个值用逗号分隔。
LOG_EXCLUDE_CHANNELS=

# 是否启用终端 ANSI 颜色。
LOG_COLOR=true

# 是否显示完整时间戳。
LOG_TIMESTAMP=true

# 是否启用人眼可读单行日志。
LOG_PRETTY=true

# 堆栈显示模式：off/error/all。
LOG_STACKS=error

# WebUI 日志页内存缓存条数上限。
LOG_BUFFER_SIZE=2000
