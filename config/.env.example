# ==================== NapCat 连接配置 ====================
# NapCat WebSocket 地址 (通常是 NapCat 开启的正向 WS 端口)
WS_URL=ws://napcat:3001

# WebSocket Token (可选，留空则不启用身份验证)
# 需要与 NapCat 配置文件中的 token 保持一致
WS_TOKEN=

# ==================== 管理员配置 ====================
# 管理员 QQ 号 (用于执行敏感指令，如订阅管理)
ADMIN_QQ=123456789

# ==================== 图片发送配置 ====================
# 是否直接通过 Base64 发送图片 (true/false)
# - true: 直接发送Base64编码的图片，无需配置目录映射，但会增加网络传输负担
# - false (推荐): 通过文件路径发送，需要正确配置 Docker 目录映射
USE_BASE64_SEND=false

# NapCat 临时文件路径配置 (仅在 USE_BASE64_SEND=false 时需要配置)
# 说明：这两个路径必须映射到同一物理目录。
#
# NAPCAT_TEMP_PATH: Bot 写入图片时使用的“真实物理路径”（宿主机路径）。
# 默认（Docker 内运行 Bot）：/app/.config/QQ/tmp/
# 本地运行示例：/Users/xxx/.../napcat/qq/tmp/
NAPCAT_TEMP_PATH=/app/.config/QQ/tmp/
#
# NAPCAT_READ_PATH: NapCat 读取图片时使用的“容器内路径”。
# 示例（NapCat Docker）：/app/.config/QQ/tmp/
NAPCAT_READ_PATH=/app/.config/QQ/tmp/

# ==================== 缓存配置 ====================
# 数据持久化缓存过期时间 (秒)
# 默认 3600 秒 (1小时)。过期后会重新请求 Bilibili API 获取最新数据
DATA_CACHE_TTL=3600

# ==================== Python 配置 ====================
# Python 解释器路径 (可选)
# Docker 环境下默认使用系统的 python3
# 本地开发环境建议指向虚拟环境
# 示例: PYTHON_PATH=venv/bin/python
# PYTHON_PATH=

# ===================== WEBUI 配置 ====================
# Dashboard 登录密码
DASHBOARD_PASSWORD=admin

# Dashboard 允许的访问来源 (用于公网部署)
# 说明：
# - 本地访问 (localhost/127.0.0.1) 无需配置，自动允许
# - 内网访问 (Tailscale/局域网) 无需配置，自动检测并允许
# - 公网访问：必须配置允许的域名或IP地址
#
# 单个来源示例：
# DASHBOARD_ALLOWED_ORIGINS=https://bot.example.com
#
# 多个来源示例（逗号分隔，无空格）：
# DASHBOARD_ALLOWED_ORIGINS=https://bot.example.com,http://1.2.3.4:3000
#
# 注意事项：
# 1. 必须包含完整的协议 (http:// 或 https://)
# 2. 如果使用非标准端口，需要包含端口号
# 3. 多个来源用逗号分隔，不要有空格
# 4. 修改后需要重启服务才能生效
#
# 留空则仅允许本地和内网访问
DASHBOARD_ALLOWED_ORIGINS=

# ==================== 日志显示配置 ====================
# 终端最低显示等级: trace / debug / info / warn / error / fatal
LOG_LEVEL=info

# 仅显示指定日志 Channel，多个值用逗号分隔；留空表示不过滤
# 示例: LOG_CHANNELS=RPC,PY,AUTH
LOG_CHANNELS=

# 排除指定日志 Channel，多个值用逗号分隔；留空表示不过滤
# 示例: LOG_EXCLUDE_CHANNELS=HTTP
LOG_EXCLUDE_CHANNELS=

# 是否启用终端 ANSI 颜色 (true/false)
LOG_COLOR=true

# 是否显示完整时间戳 (yyyy/mm/dd hh:mm:ss)
LOG_TIMESTAMP=true

# 是否启用人眼可读的 pretty 单行日志格式 (true/false)
LOG_PRETTY=true

# 堆栈显示模式: off / error / all
LOG_STACKS=error

# WebUI 日志页内存缓存条数上限
LOG_BUFFER_SIZE=2000
